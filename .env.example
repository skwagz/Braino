# Run npm run auth -- init to generate .env and its encryption key.
# Create a Google Cloud OAuth client of type Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:43821/oauth/callback
# Generated by auth init; do not change after saving a login.
# BRAINO_TOKEN_KEY=<64 hex characters>
# Optional developer override; normally leave unset to use Google login.
# GOOGLE_ACCESS_TOKEN=
