{
  "manifest_version": 3,
  "name": "Braino \u2014 Organize your Drive",
  "version": "0.2.0",
  "description": "Open your Braino workspace in a full tab to connect Google Drive, review file organization, and search your index.",
  "action": {
    "default_title": "Open Braino",
    "default_icon": {
      "16": "icons/braino-16.png",
      "32": "icons/braino-32.png",
      "48": "icons/braino-48.png",
      "128": "icons/braino-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/braino-16.png",
    "32": "icons/braino-32.png",
    "48": "icons/braino-48.png",
    "128": "icons/braino-128.png"
  }
}
